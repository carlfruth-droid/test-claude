# Vorlage für die Deploy-Zugangsdaten.
# Kopieren nach .env und ausfüllen — die .env bleibt lokal (steht in .gitignore).

# Server: steht in konsoleH bzw. in der Freischaltungs-Mail von Hetzner,
# z.B. wwwXXX.your-server.de — alternativ geht auch die eigene Domain.
HETZNER_HOST=

# Der FTP-/SFTP-Benutzername (in konsoleH unter "Zugänge" anlegen/nachsehen).
HETZNER_USER=

# Zielverzeichnis auf dem Server (Standard bei Hetzner: public_html)
HETZNER_REMOTE_DIR=public_html
