# Weiterleitung von HTTP auf HTTPS
# (funktioniert, sobald das Let's-Encrypt-Zertifikat in konsoleH aktiviert ist)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Texte gepackt ausliefern (falls das Modul auf dem Server aktiv ist)
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

# Sinnvolle Sicherheits-Header
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Seiten nicht veralten lassen (Bilder dürfen weiter gecacht werden)
  <FilesMatch "\.(?i:html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
